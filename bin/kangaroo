#!/usr/bin/env python3
"""Run the agent from anywhere: `python3 /path/to/bin/kangaroo <command>`. `mcp` starts the
stdio server a chat host launches; `setup` prints the config for each host."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from kangaroo.__main__ import main  # noqa: E402

sys.exit(main())
